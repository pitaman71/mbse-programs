{
  "name": "@mbse/programs",
  "version": "0.3.18",
  "description": "Programs as language-neutral data: complete, serializable abstract syntax trees for C, C++, Python, TypeScript, JavaScript, Verilog and SystemVerilog, with their definitions, built for transpilers that never parse or print strings (TypeScript implementation)",
  "keywords": [
    "ast",
    "abstract syntax tree",
    "c++",
    "python",
    "typescript",
    "javascript",
    "verilog",
    "systemverilog",
    "c",
    "transpiler",
    "mbse",
    "tree-sitter",
    "slang",
    "code generation"
  ],
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./Framework": "./src/Framework/index.ts",
    "./Framework/*": "./src/Framework/*.ts",
    "./Ccpp": "./src/Ccpp/index.ts",
    "./Ccpp/*": "./src/Ccpp/*.ts",
    "./Python": "./src/Python/index.ts",
    "./Python/*": "./src/Python/*.ts",
    "./TypeScript": "./src/TypeScript/index.ts",
    "./TypeScript/*": "./src/TypeScript/*.ts",
    "./Verilog": "./src/Verilog/index.ts",
    "./Verilog/*": "./src/Verilog/*.ts",
    "./Bridges": "./src/Bridges/index.ts",
    "./Bridges/*": "./src/Bridges/*.ts",
    "./Transpilers": "./src/Transpilers/index.ts",
    "./Transpilers/*": "./src/Transpilers/*.ts",
    "./Conformance/*": "./src/Conformance/*.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "python3 ../scripts/siblings.py check && npm --prefix ../../mbse-expressions/typescript5 install --no-audit --no-fund && npm --prefix ../../mbse-schemas/typescript5 install --no-audit --no-fund",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-notebooks.ts --typecheck",
    "conformance": "tsx src/Conformance/write.ts",
    "coverage": "c8 --check-coverage --100 tsx tests/run-notebooks.ts --typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@typescript-eslint/typescript-estree": "8.71.0",
    "c8": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mbse/expressions": "file:../../mbse-expressions/typescript5",
    "@mbse/schemas": "file:../../mbse-schemas/typescript5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "^0.27.0"
  }
}
